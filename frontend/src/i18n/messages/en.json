  "faq": {
    "eyebrow": "FAQ",
    "title": "International FAQ",
    "items": [
      {
        "q": "What is the approximate cost of living in Abidjan?",
        "a": "Indicative student budget: 150,000–350,000 XOF / month depending on housing and lifestyle."
      },
      {
        "q": "Is insurance required?",
        "a": "Yes — travel/student health insurance is recommended before departure."
      },
      {
        "q": "Is there campus housing?",
        "a": "Partner options and housing guidance via the IRO."
      },
      {
        "q": "Can I pay from abroad?",
        "a": "International card, Wise/transfer, and Mobile Money once in Côte d'Ivoire."
      },
      {
        "q": "Are courses in French?",
        "a": "Mostly French; progressive EN materials on some pathways."
      }
    ]
  },
