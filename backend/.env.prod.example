DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com,localhost
CORS_ALLOWED_ORIGINS=https://campus.example.com
CSRF_TRUSTED_ORIGINS=https://campus.example.com
FRONTEND_ORIGIN=https://campus.example.com
FRONTEND_DEFAULT_LOCALE=fr
DATABASE_URL=postgres://iua:CHANGE_ME@db:5432/iua_campus
REDIS_URL=redis://redis:6379/0
SECURE_SSL_REDIRECT=true
IUA_REQUIRE_MFA_ENROLLMENT=true
IUA_EXPOSE_TOKENS_IN_BODY=false
PAYMENT_WEBHOOK_SECRET=replace-with-hmac-secret
JITSI_BASE_URL=https://meet.your-campus.example
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
